<Project>

  <PropertyGroup>
    <!-- Overridden by the release workflow with the version from the git tag. -->
    <Version>0.1.0</Version>
    <Authors>Ahmed Aredah</Authors>
    <Product>QuickLook.Plugin.DuckDbViewer</Product>
    <Copyright>Copyright © Ahmed Aredah</Copyright>

    <!--
      DuckDB.NET 1.4.4 is the last release that still targets netstandard2.0, which is
      what a .NET Framework host such as QuickLook can load. The engine version and the
      bundled extension binaries must always match it.
    -->
    <DuckDbVersion>1.4.4</DuckDbVersion>
    <QuickLookCommonVersion>4.5.0</QuickLookCommonVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <ExtensionCacheDir>$(RepoRoot)artifacts\extensions\v$(DuckDbVersion)\windows_amd64\</ExtensionCacheDir>
  </PropertyGroup>

</Project>
