<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Windows shell preview handler: an out-of-process COM server that Explorer's preview
    pane and PowerToys Peek activate for the registered file extensions.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <RootNamespace>DuckDbViewer.PreviewHandler</RootNamespace>
    <AssemblyName>DuckDbViewer.PreviewHandler</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Install.cmd;Uninstall.cmd" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\DuckDbViewer.Core\DuckDbViewer.Core.csproj" />
  </ItemGroup>

</Project>
