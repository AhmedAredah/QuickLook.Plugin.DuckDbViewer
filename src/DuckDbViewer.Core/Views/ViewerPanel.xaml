<UserControl x:Class="DuckDbViewer.Views.ViewerPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DuckDbViewer.Localization"
             FontSize="12.5"
             Foreground="{DynamicResource WindowTextForeground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!--
                Column header of the data grid. Data context: ColumnHeaderViewModel.
                Clicking the header sorts; the funnel opens the column's filter.
            -->
            <DataTemplate x:Key="ColumnHeaderTemplate">
                <DockPanel Background="Transparent" ToolTip="{l:Text Sort_Tooltip}">
                    <Button x:Name="filterButton"
                            Margin="6,0,-4,0"
                            AutomationProperties.Name="{l:Text Filter_Tooltip}"
                            VerticalAlignment="Center"
                            Click="FilterButton_Click"
                            Content="&#xE71C;"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Viewer.HeaderFilterButton}"
                            ToolTip="{l:Text Filter_Tooltip}" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Viewer.IconFont}"
                                       FontSize="9"
                                       Foreground="{StaticResource Viewer.Accent}"
                                       Text="{Binding SortGlyph}" />
                        </StackPanel>
                        <TextBlock FontSize="10.5"
                                   Foreground="{StaticResource Viewer.Muted}"
                                   Text="{Binding Type}" />
                    </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                        <Setter TargetName="filterButton" Property="Foreground" Value="{StaticResource Viewer.Accent}" />
                        <Setter TargetName="filterButton" Property="Opacity" Value="1" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="PlainHeaderTemplate">
                <TextBlock FontWeight="SemiBold" Text="{Binding}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tables and views of a database -->
        <Border Grid.Column="0"
                Width="220"
                BorderBrush="{StaticResource Viewer.Divider}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding HasObjectList, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Margin="14,12,12,8"
                           DockPanel.Dock="Top"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Viewer.Muted}"
                           Text="{l:Text Sidebar_Title}" />
                <ListBox ItemContainerStyle="{StaticResource Viewer.ObjectItem}"
                         ItemsSource="{Binding Objects}"
                         SelectedItem="{Binding SelectedObject}"
                         Style="{StaticResource Viewer.ObjectList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Right"
                                           FontSize="10.5"
                                           Foreground="{StaticResource Viewer.Muted}"
                                           Text="{l:Text Kind_View}"
                                           Visibility="{Binding IsView, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayName}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tabs, summary and actions -->
            <Border Grid.Row="0"
                    Height="36"
                    BorderBrush="{StaticResource Viewer.Divider}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="4,0,8,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <RadioButton Content="{l:Text Tab_Data}"
                                     IsChecked="{Binding IsDataVisible}"
                                     Style="{StaticResource Viewer.Tab}" />
                        <RadioButton Content="{l:Text Tab_Schema}"
                                     IsChecked="{Binding IsSchemaVisible}"
                                     Style="{StaticResource Viewer.Tab}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Command="{Binding ClearFiltersCommand}"
                                Content="{l:Text Filter_ClearAll}"
                                Style="{StaticResource Viewer.LinkButton}"
                                Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource WindowTextForegroundAlternative}"
                                   Text="{Binding SummaryText}" />
                        <Border Margin="10,0,0,0"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="{StaticResource Viewer.Hover}"
                                CornerRadius="4">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="{Binding FormatName}" />
                        </Border>
                        <Button x:Name="exportButton"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{l:Text Export_Button}"
                                Padding="9,3"
                                Click="ExportButton_Click"
                                IsEnabled="{Binding CanExport}"
                                Style="{StaticResource Viewer.TextButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource Viewer.IconFont}"
                                           FontSize="11"
                                           Text="&#xEDE1;" />
                                <TextBlock Margin="6,0,0,0" Text="{l:Text Export_Button}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Rows -->
            <DataGrid x:Name="dataGrid"
                      Grid.Row="1"
                      CanUserSortColumns="True"
                      HeadersVisibility="All"
                      ItemsSource="{Binding Rows}"
                      LoadingRow="DataGrid_LoadingRow"
                      Sorting="DataGrid_Sorting"
                      Style="{StaticResource Viewer.Grid}"
                      Visibility="{Binding ShowDataGrid, Converter={StaticResource BoolToVisibility}}" />

            <!-- Schema -->
            <DataGrid Grid.Row="1"
                      HeadersVisibility="Column"
                      ItemsSource="{Binding SchemaRows}"
                      Style="{StaticResource Viewer.Grid}"
                      Visibility="{Binding ShowSchemaGrid, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="56"
                                        Binding="{Binding Position}"
                                        ElementStyle="{StaticResource Viewer.NumericCellText}"
                                        Header="#"
                                        HeaderStyle="{StaticResource Viewer.NumericColumnHeader}"
                                        HeaderTemplate="{StaticResource PlainHeaderTemplate}" />
                    <DataGridTextColumn Width="2*"
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource Viewer.CellText}"
                                        Header="{l:Text Schema_Column}"
                                        HeaderTemplate="{StaticResource PlainHeaderTemplate}" />
                    <DataGridTextColumn Width="3*"
                                        Binding="{Binding Type}"
                                        ElementStyle="{StaticResource Viewer.CellText}"
                                        Header="{l:Text Schema_Type}"
                                        HeaderTemplate="{StaticResource PlainHeaderTemplate}" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding Nullable}"
                                        ElementStyle="{StaticResource Viewer.CellText}"
                                        Header="{l:Text Schema_Nullable}"
                                        HeaderTemplate="{StaticResource PlainHeaderTemplate}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Failure or empty database -->
            <StackPanel Grid.Row="0"
                        Grid.RowSpan="4"
                        MaxWidth="560"
                        Margin="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding NoticeTitle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBox Margin="0,10,0,0"
                         HorizontalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource WindowTextForegroundAlternative}"
                         IsReadOnly="True"
                         Text="{Binding NoticeDetail, Mode=OneWay}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!-- Export progress and results, query errors -->
            <Border Grid.Row="2"
                    Padding="12,5,6,5"
                    Background="{StaticResource Viewer.Header}"
                    BorderBrush="{StaticResource Viewer.Divider}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Margin="8,0,0,0"
                                Command="{Binding ShowExportedFileCommand}"
                                Content="{l:Text Export_ShowInFolder}"
                                Style="{StaticResource Viewer.TextButton}"
                                Visibility="{Binding HasExportedFile, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding CancelExportCommand}"
                                Content="{l:Text Export_Cancel}"
                                Style="{StaticResource Viewer.TextButton}"
                                Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="4,0,0,0"
                                Command="{Binding DismissStatusCommand}"
                                Content="&#xE711;"
                                Style="{StaticResource Viewer.IconButton}"
                                ToolTip="{l:Text Status_Dismiss}"
                                Visibility="{Binding CanDismissStatus, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}" />
                </DockPanel>
            </Border>

            <!-- Position and paging -->
            <Border Grid.Row="3"
                    Height="36"
                    BorderBrush="{StaticResource Viewer.Divider}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <ProgressBar Height="2"
                                 VerticalAlignment="Top"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource Viewer.Accent}"
                                 IsIndeterminate="{Binding IsLoading}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <DockPanel Margin="12,0,8,0"
                               Visibility="{Binding IsDataVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock VerticalAlignment="Center"
                                   DockPanel.Dock="Left"
                                   Foreground="{DynamicResource WindowTextForegroundAlternative}"
                                   Text="{Binding RangeText}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Command="{Binding FirstPageCommand}"
                                    Content="&#xE892;"
                                    Style="{StaticResource Viewer.IconButton}"
                                    ToolTip="{l:Text Pager_First}" />
                            <Button Command="{Binding PreviousPageCommand}"
                                    Content="&#xE76B;"
                                    Style="{StaticResource Viewer.IconButton}"
                                    ToolTip="{l:Text Pager_Previous}" />
                            <TextBlock MinWidth="96"
                                       Margin="8,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding PageText}"
                                       TextAlignment="Center" />
                            <Button Command="{Binding NextPageCommand}"
                                    Content="&#xE76C;"
                                    Style="{StaticResource Viewer.IconButton}"
                                    ToolTip="{l:Text Pager_Next}" />
                            <Button Command="{Binding LastPageCommand}"
                                    Content="&#xE893;"
                                    Style="{StaticResource Viewer.IconButton}"
                                    ToolTip="{l:Text Pager_Last}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Filter of one column. Data context: FilterEditorViewModel, set when opened. -->
        <Popup x:Name="filterPopup"
               AllowsTransparency="True"
               Closed="FilterPopup_Closed"
               Placement="Bottom"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="290" Style="{StaticResource Viewer.Flyout}">
                <DockPanel Margin="6">
                    <TextBlock Margin="0,0,0,8"
                               DockPanel.Dock="Top"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Margin="0,0,0,6"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal">
                        <Button Command="{Binding SelectAllCommand}"
                                Content="{l:Text Filter_SelectAll}"
                                Style="{StaticResource Viewer.LinkButton}" />
                        <Button Margin="14,0,0,0"
                                Command="{Binding SelectNoneCommand}"
                                Content="{l:Text Filter_SelectNone}"
                                Style="{StaticResource Viewer.LinkButton}" />
                    </StackPanel>
                    <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                        <Button Click="RemoveFilter_Click"
                                Content="{l:Text Filter_Remove}"
                                DockPanel.Dock="Left"
                                Style="{StaticResource Viewer.TextButton}"
                                Visibility="{Binding HasExistingFilter, Converter={StaticResource BoolToVisibility}}" />
                        <Button MinWidth="76"
                                HorizontalAlignment="Right"
                                HorizontalContentAlignment="Center"
                                Click="ApplyFilter_Click"
                                Content="{l:Text Filter_Apply}"
                                IsEnabled="{Binding CanApply}"
                                Style="{StaticResource Viewer.AccentButton}" />
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0"
                               DockPanel.Dock="Bottom"
                               FontSize="11"
                               Foreground="{StaticResource Viewer.Muted}"
                               Text="{Binding TruncatedText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}" />
                    <Grid MinHeight="72" MaxHeight="280">
                        <ListBox Background="Transparent"
                                 BorderBrush="{StaticResource Viewer.Divider}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource WindowTextForeground}"
                                 ItemContainerStyle="{StaticResource Viewer.CheckItem}"
                                 ItemsSource="{Binding Items}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock Margin="8,0,2,0"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Viewer.Muted}"
                                                   Text="{Binding CountText}" />
                                        <CheckBox VerticalContentAlignment="Center"
                                                  Focusable="False"
                                                  Foreground="{DynamicResource WindowTextForeground}"
                                                  IsChecked="{Binding IsChecked}">
                                            <TextBlock x:Name="valueText"
                                                       Text="{Binding Display}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Display}" />
                                        </CheckBox>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNull}" Value="True">
                                            <Setter TargetName="valueText" Property="FontStyle" Value="Italic" />
                                            <Setter TargetName="valueText" Property="Foreground" Value="{StaticResource Viewer.Muted}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ProgressBar Height="2"
                                     VerticalAlignment="Top"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource Viewer.Accent}"
                                     IsIndeterminate="{Binding IsLoading}"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="12"
                                   VerticalAlignment="Center"
                                   Text="{Binding Error}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>

        <!-- Export formats -->
        <Popup x:Name="exportPopup"
               AllowsTransparency="True"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=exportButton}"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="250" Style="{StaticResource Viewer.Flyout}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ExportActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="ExportAction_Click"
                                        Command="{Binding Command}"
                                        Content="{Binding Title}"
                                        Style="{StaticResource Viewer.MenuButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="10,6,10,6"
                               FontSize="11"
                               Foreground="{StaticResource Viewer.Muted}"
                               Text="{l:Text Export_Hint}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
