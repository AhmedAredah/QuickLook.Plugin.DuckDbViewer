<?xml version="1.0" encoding="utf-8"?>

<!--
  One element per language (IETF tag); missing entries fall back to <en>.
  Placeholders such as {0} are filled in by the plugin and must be kept.
-->
<Translations>
  <en>
    <Sidebar_Title>Tables and views</Sidebar_Title>
    <Tab_Data>Data</Tab_Data>
    <Tab_Schema>Schema</Tab_Schema>
    <Schema_Column>Column</Schema_Column>
    <Schema_Type>Type</Schema_Type>
    <Schema_Nullable>Nullable</Schema_Nullable>
    <Schema_Yes>yes</Schema_Yes>
    <Schema_No>no</Schema_No>
    <Kind_View>view</Kind_View>
    <Summary_RowsAndColumns>{0} rows · {1} columns</Summary_RowsAndColumns>
    <Summary_Columns>{0} columns</Summary_Columns>
    <Range_Known>Rows {0}–{1} of {2}</Range_Known>
    <Range_Unknown>Rows {0}–{1}</Range_Unknown>
    <Range_Empty>No rows</Range_Empty>
    <Pager_Page>Page {0}</Pager_Page>
    <Pager_PageOf>Page {0} of {1}</Pager_PageOf>
    <Pager_First>First page</Pager_First>
    <Pager_Previous>Previous page</Pager_Previous>
    <Pager_Next>Next page</Pager_Next>
    <Pager_Last>Last page</Pager_Last>
    <Notice_OpenFailed>This file could not be previewed</Notice_OpenFailed>
    <Notice_ReadFailed>This object could not be read</Notice_ReadFailed>
    <Notice_NoObjects>This database contains no tables or views</Notice_NoObjects>
  </en>
  <ar>
    <Sidebar_Title>الجداول وطرق العرض</Sidebar_Title>
    <Tab_Data>البيانات</Tab_Data>
    <Tab_Schema>المخطط</Tab_Schema>
    <Schema_Column>العمود</Schema_Column>
    <Schema_Type>النوع</Schema_Type>
    <Schema_Nullable>يقبل القيم الفارغة</Schema_Nullable>
    <Schema_Yes>نعم</Schema_Yes>
    <Schema_No>لا</Schema_No>
    <Kind_View>طريقة عرض</Kind_View>
    <Summary_RowsAndColumns>{0} صف · {1} عمود</Summary_RowsAndColumns>
    <Summary_Columns>{0} عمود</Summary_Columns>
    <Range_Known>الصفوف {0}–{1} من {2}</Range_Known>
    <Range_Unknown>الصفوف {0}–{1}</Range_Unknown>
    <Range_Empty>لا توجد صفوف</Range_Empty>
    <Pager_Page>الصفحة {0}</Pager_Page>
    <Pager_PageOf>الصفحة {0} من {1}</Pager_PageOf>
    <Pager_First>الصفحة الأولى</Pager_First>
    <Pager_Previous>الصفحة السابقة</Pager_Previous>
    <Pager_Next>الصفحة التالية</Pager_Next>
    <Pager_Last>الصفحة الأخيرة</Pager_Last>
    <Notice_OpenFailed>تعذّرت معاينة هذا الملف</Notice_OpenFailed>
    <Notice_ReadFailed>تعذّرت قراءة هذا العنصر</Notice_ReadFailed>
    <Notice_NoObjects>لا تحتوي قاعدة البيانات هذه على جداول أو طرق عرض</Notice_NoObjects>
  </ar>
</Translations>
